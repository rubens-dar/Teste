# Todas as chaves sao OPCIONAIS. Sem nenhuma delas o pipeline ja funciona
# (Mercado Livre + Receita Federal + DuckDuckGo + raspagem de site).
# Cada chave adicionada aumenta a taxa de acerto.

# Buscador. Ordem de preferencia: serpapi > google_cse > brave > duckduckgo (sem chave)
SERPAPI_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
BRAVE_SEARCH_KEY=

# Google Places (New) - melhor fonte de telefone de negocio local
# Habilite "Places API (New)" no Google Cloud e gere uma chave.
GOOGLE_MAPS_KEY=

# Token opcional do CNPJ.ws para elevar o limite de consultas
CNPJWS_TOKEN=

# Ajustes de execucao
LH_WORKERS=4
LH_RATE_LIMIT=1.0
LH_TIMEOUT=25
LH_DEFAULT_DDD=48
LH_CIDADE=Tubarao
LH_UF=SC
